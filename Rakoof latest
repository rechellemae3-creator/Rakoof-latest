    }, sw)
    corner(knob, 7)
    local stroke = r:FindFirstChildOfClass("UIStroke")

    local state = false
    local function set(v, silent)
        state = v
        sg.Enabled = v
        if not v then tween(sw, 0.15, {BackgroundColor3 = C.off})
        else sw.BackgroundColor3 = Color3.new(1, 1, 1) end
        if stroke then
            tween(stroke, 0.15, {Color = v and C.a1 or C.off, Transparency = v and 0.15 or 0.5})
        end
        tween(knob, 0.15, {Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)})
        if not silent then
            local ok, err = pcall(cb, v)
            if not ok then warn("[gui] " .. tostring(err)) end
        end
    end
    track(r.MouseButton1Click:Connect(function() set(not state) end))
    return set
end

