-- runs a block safely so one broken feature can't stop the gui
local function guard(name, fn)
    local ok, err = pcall(fn)
    if not ok then warn("[gui] '" .. name .. "' failed: " .. tostring(err)) end
end

-- starts one background loop per flag (a re-toggle replaces the old loop)
local function runLoop(key, getWait, fn)
    S[key .. "_gen"] = (S[key .. "_gen"] or 0) + 1
    local gen = S[key .. "_gen"]
    task.spawn(function()
        while alive and S[key] and S[key .. "_gen"] == gen do
            pcall(fn)
            task.wait(getWait())
        end
    end)
end

