-- ============ TABS + SEARCH ============
local tabs, pages, registry = {}, {}, {}
local currentTab

local function reg(page, frame, key, isHeading)
    registry[page] = registry[page] or {}
    table.insert(registry[page], {frame = frame, key = (key or ""):lower(), heading = isHeading})
end

local function applyFilter()
    local page = pages[currentTab]
    if not page then return end
    local q = (searchBox.Text or ""):lower()
    for _, e in ipairs(registry[page] or {}) do
        if q == "" then
            e.frame.Visible = true
        elseif e.heading then
            e.frame.Visible = false
        else
            e.frame.Visible = e.key:find(q, 1, true) ~= nil
        end
    end
end
track(searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter))

local function selectTab(name)
    currentTab = name
    for n, page in pairs(pages) do
        local on = (n == name)
        page.Visible = on
        local t = tabs[n]
        tween(t.btn, 0.15, {BackgroundColor3 = on and C.rowHi or C.row})
        tween(t.stroke, 0.15, {Transparency = on and 0.1 or 1})
        tween(t.txt, 0.15, {TextColor3 = on and C.text or C.dim})
    end
    applyFilter()
end

