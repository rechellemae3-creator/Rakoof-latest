guard("visuals", function()
    heading(pVis, "ESP")
    local rakHL, plrHL = nil, {}

    clearESP = function()
        if rakHL then pcall(function() rakHL:Destroy() end); rakHL = nil end
        for p, hl in pairs(plrHL) do
            pcall(function() hl:Destroy() end)
            plrHL[p] = nil
        end
    end

    toggle(pVis, "Rakoof ESP", function(v) S.rakESP = v end)
    toggle(pVis, "Player ESP", function(v) S.plrESP = v end)

    task.spawn(function()
        while alive do
            task.wait(0.5)
            pcall(function()
                if S.rakESP then
                    local rk = getRakoof()
                    if rk and (not rakHL or rakHL.Parent ~= rk) then
                        if rakHL then rakHL:Destroy() end
                        rakHL = new("Highlight", {
                            Name = tostring(math.random(100000, 999999)),
                            FillColor = Color3.fromRGB(255, 0, 0),
                            OutlineColor = Color3.new(1, 1, 1),
                            FillTransparency = 0.4,
                        }, rk)
                    end
                elseif rakHL then
                    rakHL:Destroy()
                    rakHL = nil
                end

                if S.plrESP then
                    for _, p in ipairs(Players:GetPlayers()) do
                        local ch = p ~= LP and p.Character
                        if ch then
                            local hl = plrHL[p]
                            if not hl or hl.Parent ~= ch then
                                if hl then hl:Destroy() end
                                plrHL[p] = new("Highlight", {
                                    Name = tostring(math.random(100000, 999999)),
                                    FillColor = Color3.fromRGB(0, 255, 200),
                                    OutlineColor = Color3.new(1, 1, 1),
                                    FillTransparency = 0.5,
                                }, ch)
                            end
                        end
                    end
                else
                    for p, hl in pairs(plrHL) do
                        hl:Destroy()
                        plrHL[p] = nil
                    end
                end
            end)
        end
    end)

    heading(pVis, "World")
    local orig = {
        Ambient = Lighting.Ambient,
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        GlobalShadows = Lighting.GlobalShadows,
    }
    local fbOn = false
    restoreLighting = function()
        if not fbOn then return end
        fbOn = false
        pcall(function()
            Lighting.Ambient = orig.Ambient
            Lighting.Brightness = orig.Brightness
            Lighting.ClockTime = orig.ClockTime
            Lighting.GlobalShadows = orig.GlobalShadows
        end)
    end
    toggle(pVis, "Full Bright", function(v)
        if v then
            fbOn = true
            Lighting.Ambient = Color3.new(1, 1, 1)
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
        else
            restoreLighting()
        end
    end)
end)

